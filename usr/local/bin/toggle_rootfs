#!/bin/sh

CMDLINE_FILE="/boot/cmdline.txt"
OVERLAY_FILE="/boot/cmdline.overlayfs"
ROOT_FILE="/boot/cmdline.root"
BACKUP_FILE="/boot/cmdline.bak"

# Ensure script is run as root
if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root." >&2
    exit 1
fi

# Check current mode based on /proc/cmdline (actual boot params)
if grep -q "overlaytmpfs=yes" /proc/cmdline; then
    CURRENT_MODE="overlay"
else
    CURRENT_MODE="default"
fi

# Determine new mode
if [ "$CURRENT_MODE" = "overlay" ]; then
    NEW_MODE="default"
    NEW_FILE="$ROOT_FILE"
else
    NEW_MODE="overlay"
    NEW_FILE="$OVERLAY_FILE"
fi

# Display current settings
echo "Detected boot parameters: $(cat /proc/cmdline)"
echo "Current root filesystem mode: $CURRENT_MODE"
echo -n "Switch to $NEW_MODE mode? (y/N): "
read -r CONFIRM

if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
    echo "Operation canceled."
    exit 0
fi

# Remount /boot as read-write
echo "Remounting /boot as read-write..."
mount -o remount,rw /boot || { echo "Failed to remount /boot" >&2; exit 1; }

# Backup cmdline.txt before modifying
cp "$CMDLINE_FILE" "$BACKUP_FILE"

# Apply new cmdline.txt
cp "$NEW_FILE" "$CMDLINE_FILE"
sync

# Remount /boot as read-only
echo "Remounting /boot as read-only..."
mount -o remount,ro /boot

echo "Root filesystem mode switched to: $NEW_MODE"
echo -n "Reboot now? (y/N): "
read -r REBOOT_CONFIRM
if [ "$REBOOT_CONFIRM" = "y" ] || [ "$REBOOT_CONFIRM" = "Y" ]; then
    echo "Rebooting..."
    reboot
else
    echo "Please reboot for changes to take effect."
fi
