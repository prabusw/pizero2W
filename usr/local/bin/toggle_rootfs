#!/bin/sh

CMDLINE_FILE="/boot/cmdline.txt"
CMDLINE_OVERLAY="/boot/cmdline.overlayfs"
CMDLINE_ROOT="/boot/cmdline.root"
BACKUP_FILE="/boot/cmdline.bak"

# Function to prompt and handle reboot
prompt_reboot() {
    echo "contents of $CMDLINE_FILE"
    cat $CMDLINE_FILE
    read -p "Reboot required. Reboot now? [y/N] " REBOOT
    case "$REBOOT" in
        [yY]*) reboot ;;
        *) echo "Reboot manually when ready." ;;
    esac
}

# Ensure script is run as root
if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root." >&2
    exit 1
fi

# Check current mode based on /proc/cmdline (actual boot params)
if grep -q "overlaytmpfs=yes" /proc/cmdline; then
    CURRENT_MODE="overlay"
    TARGET_MODE="default"
    TARGET_CMDLINE="$CMDLINE_ROOT"  # Switch to default mode
else
    CURRENT_MODE="default"
    TARGET_MODE="overlay"
    TARGET_CMDLINE="$CMDLINE_OVERLAY"  # Switch to overlay mode
fi

# Compare /boot/cmdline.txt with the target file
if cmp -s "$CMDLINE_FILE" "$TARGET_CMDLINE"; then
    echo "Already in the desired mode ($TARGET_MODE). No changes needed."
    prompt_reboot
    exit 0
fi


# Prompt before modifying the boot configuration
echo "Switching root filesystem mode..."
echo "current contents of $CMDLINE_FILE"
cat $CMDLINE_FILE
# read -p "Change to $(basename "$TARGET_CMDLINE") mode? [y/N] " CONFIRM
read -p "Change to "$TARGET_MODE" mode? [y/N] " CONFIRM
case "$CONFIRM" in
    [yY]*)
	# Remount /boot as read-write
	echo "Remounting /boot as read-write..."
	mount -o remount,rw /boot || { echo "Failed to remount /boot" >&2; exit 1; }
        cp "$TARGET_CMDLINE" "$CMDLINE_FILE"
        sync  # Ensure changes are written to disk
	# Remount /boot as read-only
	echo "Remounting /boot as read-only..."
	mount -o remount,ro /boot
        echo "Mode switched. A reboot is required."
        prompt_reboot
        ;;
    *)
        echo "Operation cancelled."
        exit 1
        ;;
esac

